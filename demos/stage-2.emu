# Этап 2: команды и результаты должны появиться в браузере.
# Пустые строки и целые строки комментариев пропускаются.

ls
ls -a -l /example
ls "$HOME" '${HOME}' "" "имя с пробелами"
ls "# это аргумент" # это комментарий
cd ${HOME}

# Каждая ошибка ниже сообщает имя сценария и номер строки.
unknown
ls -z
cd first second
exit unexpected
ls "незакрытая строка
ls ${HOME

# Проверка продолжения после ошибки.
ls after-error
# После просмотра введите exit вручную.
